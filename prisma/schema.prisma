// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Moment {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime           // when the moment happened
  parentId    String?            // self-relation for tree structure
  parent      Moment?   @relation("MomentTree", fields: [parentId], references: [id])
  children    Moment[]  @relation("MomentTree")
  photos      Photo[]
  category    String?            // e.g. "date", "trip", "milestone", "everyday"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Photo {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  filePath  String            // path under /public/uploads
  caption   String?
  createdAt DateTime @default(now())
}

model SpecialDate {
  id          String   @id @default(cuid())
  label       String            // e.g. "Her Birthday", "Anniversary", "Valentine's Day"
  date        DateTime          // reference date (year may be arbitrary if recurring)
  recurring   Boolean  @default(true)
  type        String            // "birthday" | "anniversary" | "holiday" | "custom"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Letter {
  id          String   @id @default(cuid())
  heading     String            // e.g. "happy girlfriend's day, my love"
  subheading  String?           // e.g. "a little world, made for you"
  gifPath     String?           // path under /public/uploads, shown on the card front
  message     String            // revealed when the envelope is clicked/tapped
  isActive    Boolean  @default(true)   // only one Letter should be "active"/displayed at a time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}
