# ==========================================
# puyandmbul_web Environment Configuration
# ==========================================

# Port to expose (default: 3000)
PORT=3000

# Site Password Gate (used to unlock the website)
SITE_PASSWORD="iloveyou"

# JWT Session Secret (generate a strong random string)
SESSION_SECRET="generate-a-strong-random-secret-key-here"

# Public URL of your deployed website (e.g. https://ourlove.example.com or http://192.168.1.100:3000)
# NOTE: In Spotify Developer Dashboard, add: ${NEXT_PUBLIC_APP_URL}/api/auth/callback
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Spotify Integration
SPOTIFY_CLIENT_ID="50575c090ca6480b971fd49ba2b60352"
SPOTIFY_CLIENT_SECRET="5c1ab29c1ba14895af1a958a16b218f6"

# Playlist ID, URI, or URL (defaults to your playlist)
NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID="63IZYR9lMFKvE0VVl9L2ww"

# Database URL (Inside Docker, defaults to file:/app/data/dev.db)
DATABASE_URL="file:/app/data/dev.db"
